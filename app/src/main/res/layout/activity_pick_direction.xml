<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pickDirectionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="?attr/homeAsUpIndicator"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/direction_selection_104"
            app:tint = "@color/icon_tint"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOutbound"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="40dp"
        android:text="@string/to_mk"
        android:textSize="36sp"
        app:backgroundTint="@color/fav_bg_4"
        android:textColor="@color/fav_card_text"
        app:strokeColor="@color/dir_outb"
        app:strokeWidth="2dp"
        app:cornerRadius="16dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnInbound"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="20dp"
        android:text="@string/to_wke"
        android:textColor="@color/fav_card_text"
        android:textSize="36sp"
        app:backgroundTint="@color/fav_bg_2"
        app:cornerRadius="16dp"
        app:strokeColor="@color/dir_inb"
        app:strokeWidth="2dp" />
</LinearLayout>